DISCORD_TOKEN=your_discord_bot_token_here

# 매시업 현재 기수 (자정 멤버 동기화 시 신규/기존 멤버에 적용)
# 새 기수 시작 시점에만 값 갱신 필요.
MASHUP_GENERATION=16

# Database: sqlite 또는 supabase
DB_TYPE=sqlite

# TypeORM synchronize (true로 설정 시 엔티티 기반 스키마 자동 동기화, 기본값: false)
DB_SYNCHRONIZE=false

# Supabase (DB_TYPE=supabase일 때 필요)
# Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=postgresql://user:password@db.xxx.supabase.co:5432/postgres

# Self-ping (Render sleep 방지)
# Render에서는 자동 주입되므로 설정 불필요. 로컬에서 self-ping 동작을 테스트할 때만 설정.
# 미설정 시 self-ping이 자동 skip됨.
RENDER_EXTERNAL_URL=https://your-service.onrender.com
